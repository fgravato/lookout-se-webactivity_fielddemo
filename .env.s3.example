# Lookout S3 Logger Configuration Example
# Copy this file to .env and update with your actual values

# =============================================================================
# LOOKOUT API CONFIGURATION
# =============================================================================

# Your Lookout API access token (REQUIRED)
LOOKOUT_ACCESS_TOKEN=your_lookout_access_token_here

# Lookout API endpoint (usually doesn't need to change)
LOOKOUT_API_URL=https://mtp.lookout.com/data/web-access-feed

# =============================================================================
# AWS CONFIGURATION
# =============================================================================

# AWS region where your resources are deployed
AWS_REGION=us-east-1

# S3 bucket name for storing logs (REQUIRED)
S3_BUCKET_NAME=your-company-lookout-logs

# Kinesis Data Firehose stream name (REQUIRED)
FIREHOSE_STREAM_NAME=lookout-web-activity-stream

# AWS credentials (if not using IAM roles/instance profiles)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# How often to poll the Lookout API (seconds)
# Default: 300 (5 minutes)
POLL_INTERVAL=300

# Maximum number of events to buffer before sending to Firehose
# Default: 500
BUFFER_SIZE_LIMIT=500

# Maximum time to wait before flushing buffer (seconds)
# Default: 300 (5 minutes)
BUFFER_TIME_LIMIT=300

# Logging level (DEBUG, INFO, WARNING, ERROR)
# Default: INFO
LOG_LEVEL=INFO

# Maximum number of retry attempts on failure
# Default: 3
MAX_RETRIES=3

# Delay between retry attempts (seconds)
# Default: 60
RETRY_DELAY=60

# =============================================================================
# ADVANCED CONFIGURATION (Optional)
# =============================================================================

# For high-volume environments, you might want to tune these:

# High-volume configuration example:
# POLL_INTERVAL=60           # Poll every minute
# BUFFER_SIZE_LIMIT=1000     # Larger batches
# BUFFER_TIME_LIMIT=120      # Flush every 2 minutes

# Low-volume configuration example:
# POLL_INTERVAL=900          # Poll every 15 minutes
# BUFFER_SIZE_LIMIT=100      # Smaller batches
# BUFFER_TIME_LIMIT=600      # Flush every 10 minutes

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env:
#    cp .env.s3.example .env

# 2. Update the REQUIRED values above with your actual configuration

# 3. Set up AWS infrastructure:
#    python aws_setup.py --bucket-name "your-company-lookout-logs" --stream-name "lookout-web-activity-stream"

# 4. Install dependencies:
#    pip install -r requirements_s3.txt

# 5. Test configuration:
#    python test_s3_logger.py

# 6. Run the service:
#    python lookout_s3_logger.py

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit this file with real credentials to version control
# - Use IAM roles instead of access keys when possible
# - Ensure your S3 bucket has appropriate access policies
# - Monitor CloudWatch for any security alerts
# - Regularly rotate your Lookout API tokens
